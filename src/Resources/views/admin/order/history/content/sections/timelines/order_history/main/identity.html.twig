{% set event = hookable_metadata.context.event %}

{% if event.shopUser.username|default(null) is not null %}
    {% set shopUserLink = path('sylius_admin_customer_show', {id: event.shopUser.customer.id}) %}
    {% set user = '<a href="' ~ shopUserLink ~ '"> ' ~ ux_icon('tabler:user') ~ event.shopUser.username ~ '</a>' %}
{% elseif event.adminUser.username|default(null) is not null %}
    {% set adminUserLink = path('sylius_admin_admin_user_update', {id: event.adminUser.id}) %}
    {% set user = '<a href="' ~ adminUserLink ~ '">' ~ ux_icon('tabler:lock') ~ event.adminUser.username ~ '</a>' %}
{% else %}
    {% set user = '<i class="user secret icon"></i> ' ~ ' anonymous' %}
{% endif %}
<span data-bs-toggle="tooltip" data-bs-title="s">
    {{ ux_icon('tabler:calendar') }}
    {{ event.createdAt|format_datetime('full', 'none', locale='fr') }}
</span>
<span data-bs-toggle="tooltip" data-bs-title="sd">
    {{ ux_icon('tabler:clock') }}
    {{ event.createdAt|format_datetime('none', 'long', locale='fr') }}
</span>
<span data-bs-toggle="tooltip" data-bs-title="{{ 'mbiz_order_history.ui.ip'|trans }}">
    {{ ux_icon('tabler:device-desktop') }}
    {{ event.ip }}
</span>
<span data-bs-toggle="tooltip" data-bs-title="{{ 'mbiz_order_history.ui.firewall'|trans }}">
    {{ ux_icon('tabler:shield-cog') }}
    {{ event.firewall }}
</span>
<span data-bs-toggle="tooltip" data-bs-title="User">
    {{ user|raw }}
</span>
